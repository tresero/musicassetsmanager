-- Included by every test file, inside its transaction, before plan().
-- Everything here is rolled back with the test.
--
-- Two accounts, a and b, each with an Owner. Account a has one of every
-- catalog record, linked the way the app links them; account b has a person,
-- a song, a recording and a release of its own. tests.id('a_song') gives a
-- fixture's id. tests.sign_in('b') acts as b's Owner, as PostgREST does:
-- the role app_user with the account and user in request.jwt.claims.
-- tests.sign_out() goes back to the owner of the database, which bypasses
-- row security, to check what really happened.

CREATE EXTENSION IF NOT EXISTS pgtap;

CREATE SCHEMA tests;
GRANT USAGE ON SCHEMA tests TO app_user;

CREATE TABLE tests.account (key text PRIMARY KEY, account_id uuid NOT NULL, user_id uuid NOT NULL);
CREATE TABLE tests.fx (name text PRIMARY KEY, id integer NOT NULL);
GRANT SELECT ON tests.account, tests.fx TO app_user;

CREATE FUNCTION tests.id(p_name text) RETURNS integer
  LANGUAGE sql STABLE
AS $$ SELECT id FROM tests.fx WHERE name = p_name $$;

-- pgTAP keeps its count in temporary tables the test's owner created, so the
-- signed-in role is given them before each switch.
CREATE FUNCTION tests.sign_in(p_key text) RETURNS void
  LANGUAGE plpgsql
AS $$
DECLARE
  t record;
  a tests.account;
BEGIN
  RESET ROLE;
  FOR t IN SELECT relname FROM pg_class
            WHERE relnamespace = pg_my_temp_schema() AND relkind IN ('r', 'S')
  LOOP
    EXECUTE format('GRANT ALL ON pg_temp.%I TO app_user', t.relname);
  END LOOP;
  SELECT * INTO a FROM tests.account WHERE key = p_key;
  PERFORM set_config('request.jwt.claims',
                     json_build_object('account_id', a.account_id, 'sub', a.user_id,
                                       'role', 'app_user')::text, true);
  SET LOCAL ROLE app_user;
END;
$$;

CREATE FUNCTION tests.sign_out() RETURNS void
  LANGUAGE plpgsql
AS $$
BEGIN
  RESET ROLE;
  PERFORM set_config('request.jwt.claims', '', true);
END;
$$;
GRANT EXECUTE ON ALL FUNCTIONS IN SCHEMA tests TO app_user;

INSERT INTO tests.account VALUES
  ('a', '00000000-0000-7000-8000-0000000000a1', '00000000-0000-7000-8000-0000000000a2'),
  ('b', '00000000-0000-7000-8000-0000000000b1', '00000000-0000-7000-8000-0000000000b2');
INSERT INTO music.account (id, name)
  SELECT account_id, 'Test account ' || key FROM tests.account;
INSERT INTO music.user_account (id, account_id, email, password_hash, role_id)
  SELECT user_id, account_id, key || '@example.com', 'not a hash',
         (SELECT id FROM music.account_role WHERE name = 'Owner')
    FROM tests.account;

DO $$
DECLARE
  a uuid := (SELECT account_id FROM tests.account WHERE key = 'a');
  b uuid := (SELECT account_id FROM tests.account WHERE key = 'b');
  composer integer := (SELECT id FROM music.role WHERE ddex_code = 'Composer');
  v integer;
BEGIN
  INSERT INTO music.contact (account_id, first_name, last_name)
    VALUES (a, 'Ada', 'Example') RETURNING id INTO v;
  INSERT INTO tests.fx VALUES ('a_contact', v);
  INSERT INTO music.organization (account_id, name)
    VALUES (a, 'Example Publishing') RETURNING id INTO v;
  INSERT INTO tests.fx VALUES ('a_organization', v);
  INSERT INTO music.song (account_id, title)
    VALUES (a, 'A Song') RETURNING id INTO v;
  INSERT INTO tests.fx VALUES ('a_song', v);
  INSERT INTO music.song_writer (song_id, contact_id, role_id, share, controlled)
    VALUES (tests.id('a_song'), tests.id('a_contact'), composer, 100, true) RETURNING id INTO v;
  INSERT INTO tests.fx VALUES ('a_writer', v);
  INSERT INTO music.recording (account_id, title)
    VALUES (a, 'A Recording') RETURNING id INTO v;
  INSERT INTO tests.fx VALUES ('a_recording', v);
  INSERT INTO music.recording_song (recording_id, song_id)
    VALUES (tests.id('a_recording'), tests.id('a_song'));
  INSERT INTO music.recording_credit (recording_id, contact_id)
    VALUES (tests.id('a_recording'), tests.id('a_contact')) RETURNING id INTO v;
  INSERT INTO tests.fx VALUES ('a_credit', v);
  INSERT INTO music.release (account_id, title)
    VALUES (a, 'A Release') RETURNING id INTO v;
  INSERT INTO tests.fx VALUES ('a_release', v);
  INSERT INTO music.release_track (release_id, recording_id, track_number)
    VALUES (tests.id('a_release'), tests.id('a_recording'), 1) RETURNING id INTO v;
  INSERT INTO tests.fx VALUES ('a_track', v);
  INSERT INTO music.artist (account_id, name)
    VALUES (a, 'Ada Example') RETURNING id INTO v;
  INSERT INTO tests.fx VALUES ('a_artist', v);
  INSERT INTO music.document (account_id, title, storage_kind, storage_uri)
    VALUES (a, 'A Split Sheet', 'url', 'https://example.com/split.pdf') RETURNING id INTO v;
  INSERT INTO tests.fx VALUES ('a_document', v);
  INSERT INTO music.song_document (song_id, document_id)
    VALUES (tests.id('a_song'), tests.id('a_document'));

  INSERT INTO music.contact (account_id, first_name, last_name)
    VALUES (b, 'Bea', 'Example') RETURNING id INTO v;
  INSERT INTO tests.fx VALUES ('b_contact', v);
  INSERT INTO music.song (account_id, title)
    VALUES (b, 'B Song') RETURNING id INTO v;
  INSERT INTO tests.fx VALUES ('b_song', v);
  INSERT INTO music.recording (account_id, title)
    VALUES (b, 'B Recording') RETURNING id INTO v;
  INSERT INTO tests.fx VALUES ('b_recording', v);
  INSERT INTO music.release (account_id, title)
    VALUES (b, 'B Release') RETURNING id INTO v;
  INSERT INTO tests.fx VALUES ('b_release', v);
END;
$$;
