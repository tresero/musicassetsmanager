# Read-only connection as the mamupload role. It reads storage settings and
# the stored-file references the sweep keeps, and listens for invites to mail.
MAM_DATABASE_URL=postgres://mamupload:PASSWORD@localhost:5432/music_tracker?sslmode=disable

# Must match jwt-secret in postgrest.conf, or tokens will not validate.
MAM_JWT_SECRET=same-as-postgrest

MAM_LISTEN=127.0.0.1:3001
MAM_LOCAL_ROOT=/var/lib/mam/files

# The app's public address, used for the link in invite emails.
MAM_APP_URL=https://admin.example.com

# Sender of invite emails, sent through the local mail server on port 25.
MAM_MAIL_FROM=Music Assets Manager <no-reply@example.com>
